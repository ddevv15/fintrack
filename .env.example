# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git; this file is committed so you can see what the app needs.

# InsForge project URL. Read it from the "oss_host" field in
# .insforge/project.json after linking the project.
NEXT_PUBLIC_INSFORGE_URL=

# InsForge anon key. Read it with: npx @insforge/cli secrets get ANON_KEY
# This one is safe in the browser. The admin API key is not, and is not used here.
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# The origin this app answers on, with no trailing slash. Used to build the URL
# Google sends you back to after signing in. It has to match a redirect URL the
# InsForge dashboard allows. http://localhost:3000 locally.
APP_URL=http://localhost:3000

# The currency the sign up form preselects. NOT the app's currency any more:
# spec 0004 moved that onto your profile, and lib/settings.ts is what reads it.
APP_CURRENCY=USD

# The time zone the sign up form suggests when the browser offers none. NOT the
# app's time zone any more: what today is comes from your own profile, through
# getSettings() in lib/settings.ts. See lib/time.ts.
APP_TIMEZONE=America/New_York

# Optional. The Arcjet site key, which turns on attempt limiting for sign in,
# sign up, and password reset. Leave it out and those forms are unlimited: the
# whole feature fails open on purpose, so a missing key or an Arcjet outage
# never locks you out of your own account. It logs a warning either way.
# Get one with: npx @arcjet/cli auth login, then sites get-key.
ARCJET_KEY=

# Optional. Set UI_GALLERY=1 to reach the component gallery at /design, which
# renders every UI component in every state. Leave the line out entirely and
# those routes are a 404, which is what production runs. Handy on a preview
# deployment when you want to check tap targets on a real phone.
# See docs/design.md.

# --- Integration tests only (npm run test:integration) -----------------------
# The tests in tests/integration/ sign in as two real accounts and prove that
# neither can read or change the other's money. Everything in tests/unit/ runs
# without these; `npm test` never touches the network.
#
# These two accounts are created once, then reused. They live at unroutable
# .invalid addresses on purpose, so no mail can ever leave for them. See
# docs/migrations.md, "Running the integration tests", for the four commands
# that recreate them if they are ever deleted.
INSFORGE_TEST_EMAIL_A=
INSFORGE_TEST_EMAIL_B=
# One password, used for both. Never commit it.
INSFORGE_TEST_PASSWORD=
