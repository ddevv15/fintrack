# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values stay local, the documented example is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP server config: holds a full access InsForge admin key inline
.mcp.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# InsForge project link. Holds the project id the CLI reads; not secret, but
# machine specific, so it stays out of the repo.
.insforge

# Assistant specific config directories. Added by `insforge link`.
# NOTE: .agents and .claude are deliberately NOT here. This project commits its
# vendored agent skills (.agents/skills/, .claude/skills/) and AGENTS.md points
# at those paths, so ignoring them would silently drop any skill added later.
.agent
.augment
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf
